{
  "name": "midnightexpresslkn-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --check js/booking.js && node --check js/booking.min.js && vitest run --coverage && playwright test",
    "test:unit": "vitest run --coverage",
    "test:browser": "playwright test",
    "lint": "eslint js/booking.js",
    "html": "html-validate index.html",
    "audit": "npm audit --audit-level=high",
    "check": "node scripts/ci.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "html-validate": "^11.18.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "vitest": "^5.1.0"
  }
}
